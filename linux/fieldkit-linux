#!/usr/bin/env python3
"""Run directly from a checkout: no installation or bytecode writes."""

import sys

sys.dont_write_bytecode = True

from fieldkit_linux.cli import main

if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("Collection interrupted; reports may be incomplete.", file=sys.stderr)
        sys.exit(130)
